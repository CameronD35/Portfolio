---
import Social from './Social.astro';
import Signature from './Signature.astro';
import '../styles/global.css';
import Seperator from './Seperator.astro';

import { Icon } from 'astro-icon/components';

// force footer to bottom of page if content height smaller than screen height
---

<footer class="footer">
    
    <div class="socialContainer">

        <Social platform="X" username="camdemartini" color="var(--footer-accent)" hoverColor="var(--footer-accent-hover)">
            <Icon name="mdi:twitter" size="1.25em"/>
        </Social>
        <Seperator height="20px" width="2px" color="var(--footer-accent)"/>
        <Social platform="GitHub" username="CameronD35" color="var(--footer-accent)" hoverColor="var(--footer-accent-hover)">
            <Icon name="mdi:github" size="1.25em"/>
        </Social>
        <Seperator height="20px" width="2px" color="var(--footer-accent)"/>
        <Social platform="YouTube" username="@CameronDeMartini" color="var(--footer-accent)" hoverColor="var(--footer-accent-hover)">
            <Icon name="mdi:youtube" size="1.25em"/>
        </Social>
        <Seperator height="20px" width="2px" color="var(--footer-accent)"/>
        <Social platform="LinkedIn" username="in/cameron-demartini" color="var(--footer-accent)" hoverColor="var(--footer-accent-hover)">
            <Icon name="mdi:linkedin" size="1.25em"/>
        </Social>
        <Seperator height="20px" width="2px" color="var(--footer-accent)"/>
        <Social href="mailto:camerondemartini@gmail.com" color="var(--footer-accent)" hoverColor="var(--footer-accent-hover)">
            <Icon name="mdi:email" size="1.25em"/>
        </Social>

    </div>

    <Signature width="200px" color="var(--footer-accent)"/>
    
</footer>

<style>

    .footer {

        display: flex;
        align-items: center;
        justify-content: space-between;

        background-color: var(--footer-color);

        width: 100%;
        padding: 2em;

        transition: 0.5s var(--standard-transition-timing-no-bounce);

        /* clip-path: url(#cool-curve); */

    }

    #svg_filter {

        position: fixed;

    }

    .socialContainer{

        display: flex;
        align-items: center;


    }

    .fixed {

        position: fixed;
        bottom: 0%;

    }

    @media screen and (max-width: 650px) {
        
        .footer {

            flex-direction: column-reverse;
            gap: 1em;


        }

    }

</style>