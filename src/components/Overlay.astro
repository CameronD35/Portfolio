---
import "../styles/global.css"

interface Props {

    width?: string;
    height?: string;

}

const { width = "60%", height = "60%"} = Astro.props;
---

<div class="overlay" data-open="false">

    

</div>


<style define:vars={{ width, height }}>

    .overlay {

        position: fixed;
        width: var(--width);
        height: var(--height);
        top: calc(50% - var(--height)/2);
        left: calc(50% - var(--width)/2);

        z-index: 4;

    }

    .overlay::after {

        content: '';
        display: block;
        position: absolute;
        background-color: var(--overlay-bg-color);
        width: 100%;
        height: 100%;

        backdrop-filter: var(--BIG-blur);

    }

    [data-open="true"] {

        display: block;

    }
    
    [data-open="false"] {

        display: none;

    }

</style>