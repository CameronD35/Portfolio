---
interface Props {

    width: string;
    color?: string;
    outline?: boolean;
    outlineColor?: string[];

}

const { width, color = "var(--custom-white)", outline = false, outlineColor = "white"} = Astro.props;
import { Icon } from "astro-icon/components";
---

<div class="signatureContainer">

    {outline && <Icon name="signature" class="outline"/>}
    <Icon name="signature" class="base"/>

</div>

<script>

    const outline = document.querySelector(".outline");

    function updateMousePosition(evt: any) {

        const box = outline?.getBoundingClientRect();

        document.documentElement.style.setProperty("--mouse-x", `${evt.clientX - box?.left!}px`);
        document.documentElement.style.setProperty("--mouse-y", `${evt.clientY - box?.top!}px`);

        // console.log(evt.screenX, evt.screenY);

    }

    window.addEventListener("mousemove", updateMousePosition);

</script>

<style define:vars={{width, color, outlineColor1: outlineColor[0], outlineColor2: outlineColor[1], outlineColor3: outlineColor[2]}}>

    .outline {

        position: absolute;

        z-index: 2;
        mask-image: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), black 50px, transparent 100px); 
        pointer-events: none;

    }

    .outline[data-icon]{
        
        color: rgba(0,0,0,0);
        stroke: var(--custom-white);
        stroke-width: 0.5px;
        paint-order: stroke;

    }

    .base[data-icon]{
        color: var(--color);
    }

    [data-icon] {

        width: var(--width);
        height: auto;

    }

    .signatureContainer {

        display: flex;
        justify-content: center;
        align-items: center;

    }

</style>