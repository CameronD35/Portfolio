---
import Year from "./Year.astro"
import ProjectCard from "./ProjectCard.astro"

interface Props {

    experiences: any[];
    year: string;

}

const { experiences, year } = Astro.props;

---
<div class="year-box">

    <Year year={year}/>

    <ul class="experience-list">
        
        {experiences?.map((project: any, i) => <ProjectCard frontmatter={project.frontmatter} fileName={experiences[i].url.split('/')[3].slice(0, -4)}/>)}
        
    </ul>

</div>


<style>

    .experience-list {
        
        list-style-type: none;
        display: flex;
        flex-direction: column;
        padding: 0;
        display: flow-root;

    }

    .year-box:has(.experience-list:hover) {

        .text {

            opacity: 1;

        }
9
    }



</style>