---
interface Props {

    href?: string;
    title: string;
    isDropdown?: string;
    dropdownComponents?: Array<string>;
    containerName?: string;

}

const { href, title, isDropdown = "false", dropdownComponents = [], containerName} = Astro.props;
import { Icon } from "astro-icon/components";
import Dropdown from "./Dropdown.astro";

---
<div class="pop-up-nav-component">

    <a href={href} data-is-dropdown={isDropdown} data-title={title} class="nav-title">

        <span class="nav-link-title">

            {title}

        </span>

        { (isDropdown === "true") && <Icon name="Dropdown_Arrow" class="arrow"/> }
    </a>

    { (isDropdown === "true") && <Dropdown containerName={`${containerName}`} components={dropdownComponents}/> }

</div>

<style>

    .pop-up-nav-component {

        position: relative;
        width: auto;
        height: auto;
        opacity: 0;

    }

    .pop-up-nav-component .nav-link-title {

        color: var(--custom-white);

    }

    .pop-up-nav-component:has([data-is-dropdown="true"]) {
        z-index: 10;
    }

    .arrow {

        height: 0.375em;
        width: auto;
        color: var(--custom-white);

    }

    [data-is-dropdown="true"] {

        span::after {

            display: none;

        }

        .nav-link-title {

            cursor: default;

        }

    }

</style>
