---
import type { ImageMetadata } from "astro";
import "../styles/global.css";
import { Image } from 'astro:assets';
import { Icon } from "astro-icon/components";

interface Props {

    color?: string;
    title: any;
    desc: string;

}

const {title, desc, color = "var(--custom-black)"} = Astro.props;

const assets = import.meta.glob<{default: ImageMetadata}>('/src/assets/themes/**/*.{jpeg,jpg,webp,png,gif,svg}');

// console.log(assets);

const directory = "/src/assets/themes/" + title;

let relevantAssets: Record<string, Function> = {};

Object.keys(assets).forEach((asset) => {

    const assetDirectory = asset.substring(0, directory.length);


    if (assetDirectory === directory) {

        relevantAssets[asset] = assets[asset];


    }

});

---

<li class="theme-card">

    <div class="card">

        <Icon name={`${title}`} class="logo"/>

        <span class="desc">{desc}</span>
            
        <Icon name={`${title}`} class="bg-image"/>

        <div class="left-shadow"></div>

        <div class="asset-container">

            {Object.keys(relevantAssets).map((asset) => {

                return <div class="asset-box" data-url={relevantAssets[asset]()}> <Image src={relevantAssets[asset]()} alt={"litty"} class="asset"/> </div>;

            })}

        </div>

        <div class="right-shadow"></div>

    </div>

    <div class="background"></div>

</li>

<style define:vars={{ color }}>

    .left-shadow, .right-shadow {

        height: 100%;
        top: 0;
        width: 15%;
        position: absolute;
        transition: 0.2s;
        
        z-index: 2;

    }

    .right-shadow {

        background-image: linear-gradient(to left, var(--color) 20%, transparent 100%);
        right: 0;
        opacity: 1;

    }

    .left-shadow {

        background-image: linear-gradient(to right, var(--color) 20%, transparent 100%);
        left: 0;
        opacity: 0;

    }

    .asset-container {

        width: 100%;
        height: 400px;
        position: relative;
        display: flex;

        gap: 2em;

        overflow-x: scroll;
        overflow-y: hidden;

    }

    .asset-container::-webkit-scrollbar {

        display: none;

    }

    .asset-box {
        
        width: fit-content;
        height: 100%;
        position: relative;
        background-image: attr(data-url);
        backdrop-filter: blur(5px);

    }

    .asset {

        width: auto;
        height: 100%;
        position: relative;
        border-radius: 1em;

        z-index: 1;

    }

    .theme-card {

        padding: 0;
        position: relative;

    }

    .background {

        position: absolute;

        inset: 0;
        width: 100%;
        height: 100%;
        transform: scaleX(0.75);
        z-index: -2;
        border-radius: 2em;

        background-color: var(--color);
        pointer-events: none;

        /* transition-timing-function: var(--standard-transition-timing-no-bounce); */
        transition-duration: 0.8s;

    }

    .logo {

        font-size: 2em;
        color: var(--custom-white);
        transition: 0.5s var(--standard-transition-timing-no-bounce);
        transform-origin: left;

        z-index: 3;

    }

    .desc {

        font-size: 1em;
        font-weight: normal;
        color: var(--custom-white);
        transition: 0.5s var(--standard-transition-timing-no-bounce);
        transform-origin: left;

        z-index: 3;

    }

    .card {

        background-color: var(--color);
        padding: 2em;
        display: flex;
        flex-direction: column;
        border-radius: 2em;
        overflow: hidden;
        position: relative;
        background-size: cover;
        transform-origin: center;
        margin: 1.5em 2em;

        transition-duration: 0.4s;

        gap: 1em;

    }

    .card::after {

        content: "";
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        
        /* background-color: red; */


    }

    .bg-image {

        font-size: 5em;
        position: absolute;
        width: 100%;
        height: 100%;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        transition: 0.5s var(--standard-transition-timing-no-bounce);
        transform-origin: 0% 0%;
        scale: 0;
        color: var(--custom-white);
        opacity: 0;
        filter: blur(30px);

    }

    @media screen and (max-width: 850px) {

        .asset-container {

            height: 300px;
            gap: 1.75em;

        }

        .logo {

            font-size: 1.75em;

        }

        .desc {

            font-size: 0.85em;

        }

    }

    @media screen and (max-width: 500px) {

        .asset-container {

            height: 150px;
            gap: 1.5em;

        }

        .logo {

            font-size: 1.5em;

        }

        .desc {

            font-size: 0.7em;

        }

    }

</style>

