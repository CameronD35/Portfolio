---
import "../styles/global.css"
import DropdownComponent from "./DropdownComponent.astro";
import Seperator from "./Seperator.astro";

interface Props {

    components: Array<string>;
    containerName: string;

}

const {components, containerName} = Astro.props;

// console.log(components);

// THERE IS A UI BUG. AFTER THE NAV COMPRESSES AND UNCOMPRESSES, THE BACKDROP FILTER SEEMS TO DISAPPEAR
---

<div class="dropdown" data-open="false">
    <ul>

        {components.map((comp, i) => (

            <>
            <DropdownComponent href={`/${containerName}/${comp.toLowerCase().replaceAll(' ', '-')}`} title={comp}/>
            {(i != components.length - 1) && <Seperator height="2px" width="5em" color="var(--nav-color)" horizontal="true" isli="true"/>}
            </>

        ))}

    </ul>
</div>

<style>

    .dropdown {

        backface-visibility: hidden;

        width: 100%;
        height: auto;
        background-color: var(--custom-black-t);
        backdrop-filter: var(--BIG-blur) !important;
        box-shadow: 0px 0px 10px var(--custom-black-t);
        position: absolute;
        top: 100%;
        border-radius: 0.5em;
        padding: 1em 0.5em;
        z-index: 3;
        transition: 0.5s var(--standard-transition-timing-no-bounce);
        transform-origin: top;
        filter: unset;

        ul .seperator {

            opacity: 0.25;

        }

        ul li {

            transition: 0.25s var(--standard-transition-timing-no-bounce);
            animation-delay: 0.2s;

        }

    }

    [data-open="false"] {

        display: flex;
        pointer-events: none;
        transform: translateY(-1em);
        opacity: 0;
        filter: var(--BIG-blur);

        ul li {

            scale: 1.2;

        }

    }

    [data-open="true"] {

        display: flex;
        pointer-events: all;
        transform: translateY(0);
        opacity: 1;
        filter: none;

        ul li {

            scale: 1;

        }

    }

    ul {

        padding: 0;
        margin: 0;
        list-style-type: none;
        text-align: center;
        width: 100%;
        align-items: center;
        display: flex;
        flex-direction: column;
        gap: 1em;


    }

</style>