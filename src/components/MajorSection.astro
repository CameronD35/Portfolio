---
import FullWidthSection from "./FullWidthSection.astro";
import PreviewGallery from "./PreviewGallery.astro";
import Button from "./Button.astro";
import '../styles/global.css';

interface Props {

    title: string;
    desc?: string;
    isLeft?: string;
    color?: string;
    buttonmsg?: string;
    href?: string;
    imageNames?: string[];
    imageDirectory?: string;

}

const { title, desc = "This is a fire description.", isLeft = "false", color = "var(--custom-black)", buttonmsg = title, href = "/", imageDirectory = href.split("/"), imageNames = ["MDOSC.webp", "StellersJay9-16.webp", "VibinLizard.webp"]} = Astro.props;

const imageDir = (() => {

    if (typeof imageDirectory == "object") {

        return imageDirectory[imageDirectory.length - 1];

    } else {

        return imageDirectory;

    }

})();

console.log(imageDir)

let originDir;

if (isLeft == "true") { originDir = "left"; }
else if (isLeft == "false") { originDir = "right"; }

---

<FullWidthSection height="100vh" color=`${color}`>

    <div class="majorContentBox" data-isLeft=`${isLeft}`>

        <div class="galleryBox">

            <PreviewGallery imageNames={imageNames} imageDirectory={imageDir} width="400px" height="600px"/>

        </div>

        <div class="infoBox">

            <div class="title-subtitle">

                <span class="title">{title.toUpperCase()}</span>
                <span>{desc}</span>

            </div>

            <Button href={href} styleFlags={["big", `${originDir}Origin`]} bgColor="var(--custom-black-t)", textColor="var(--custom-white)">{buttonmsg}</Button>

        </div>

    </div>
    

</FullWidthSection>

<style>

    .majorContentBox {

        width: 100%;
        height: 100%;
        padding: 5%;
        color: var(--custom-white);
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;

    }

    [data-isLeft="true"] {

        flex-direction: row-reverse;

        .infoBox {

            align-items: start !important;

        }
        
        .title {

            text-align: left !important;

        }

        .title-subtitle {

            align-items: start !important;

        }

    }

    [data-isLeft="false"] {
        
        .title-subtitle {

            text-align: right !important;

        }

    }

    .galleryBox {

        /* background-color: green; */
        width: 40%;
        height: 100%;

        display: flex;
        justify-content: center;
        align-items: center;

    }

    .infoBox {

        /* background-color: blue; */
        width: 60%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: end;
        justify-content: center;
        gap: 2em;

    }

    .title {

        font-family: "Oi", serif;
        font-size: min(4.5em, 5vw);
        text-align: right;

    }

    .title-subtitle {

        display: flex;
        flex-direction: column;
        align-items: end;
        justify-content: center;

    }

    @media screen and (max-width: 850px) {

        .majorContentBox {

            flex-direction: column;

        }

        [data-isLeft="true"] {

            .infoBox {

                align-items: center !important;

            }
            
            .title {

                text-align: center !important;

            }

            span {

                text-align: center !important;

            }

            .title-subtitle {

                align-items: center !important;

            }

        }
        

        .infoBox {

            align-items: center !important;
            width: 80%;

        }

        [data-isLeft="false"] {
        
            .title-subtitle {

                text-align: center !important;
                align-items: center;

            }

        }
        
        .title {

            text-align: center !important;

        }

        .galleryBox {

            width: 100%;
            margin-bottom: -20%;

        }


    }
    

</style>