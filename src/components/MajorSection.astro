---
import FullWidthSection from "./FullWidthSection.astro";
import PreviewGallery from "./PreviewGallery.astro";
import Button from "./Button.astro";
import '../styles/global.css';

interface Props {

    title: string;
    desc?: string;
    link?: string;
    isLeft?: string;
    color?: string;
    buttonmsg?: string;
    href?: string;
    imageNames?: string[];
    imageDirectory?: string;

}

const { title, desc = "This is a fire description.", link, isLeft = "false", color = "var(--custom-black)", buttonmsg = title, href = "/", imageDirectory = href.split("/")[2], imageNames = ["MDOSC.webp", "StellersJay9-16.webp", "VibinLizard.webp"]} = Astro.props;

---

<FullWidthSection height="100vh" color=`${color}`>

    <div class="majorContentBox" data-isLeft=`${isLeft}`>

        <div class="galleryBox">

            <PreviewGallery imageNames={imageNames} imageDirectory={imageDirectory} width="400px" height="600px"/>

        </div>

        <div class="infoBox">

            <div class="title-subtitle">

                <span class="title">{title.toUpperCase()}</span>
                <span>{desc}</span>

            </div>

            <Button msg={buttonmsg} href={href} styleFlags={["big"]}/>

        </div>

    </div>
    

</FullWidthSection>

<style>

    .majorContentBox {

        width: 100%;
        height: 100%;
        padding: 5%;
        color: var(--custom-white);
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;

    }

    [data-isLeft="true"] {

        flex-direction: row-reverse;

        .infoBox {

            align-items: start !important;

        }
        
        .title {

            text-align: left !important;

        }

        .title-subtitle {

            align-items: start !important;

        }

    }

    [data-isLeft="false"] {
        
        .title-subtitle {

            text-align: right !important;

        }

    }

    .galleryBox {

        /* background-color: green; */
        width: 40%;
        height: 100%;

        display: flex;
        justify-content: center;
        align-items: center;

    }

    .infoBox {

        /* background-color: blue; */
        width: 60%;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: end;
        justify-content: center;
        gap: 2em;

    }

    .title {

        font-family: "Oi", serif;
        font-size: min(4.5em, 5vw);
        text-align: right;

    }

    .title-subtitle {

        display: flex;
        flex-direction: column;
        align-items: end;
        justify-content: center;

    }
    

</style>