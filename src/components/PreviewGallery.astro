---
interface Props {

    images: string[];
    width?: string;
    height?: string;

}

const { images, width = "20%", height = "20%"} = Astro.props;

import "../styles/global.css"
---

<div class="photo-gallery">

    <div class="image-box">

        {images.map((image) =>
            <div class="image">

                {image}
        
            </div>
        )}

    </div>

</div>


<style define:vars={{width, height}}>

    .photo-gallery {

        width: var(--width);
        height: var(--height);
        /* background-color: red; */
        position: relative;

    }

    .image-box {

        width: 100%;
        height: 100%;

        position: relative;

    }

    .image-box:hover{

        .image:nth-child(1), .image:nth-child(3) {

            scale: 0.72;
            offset-distance: 100%;
            opacity: 0.8;

        }

        .image:nth-child(1) {

            transform: translateX(-20%) translateY(-20%) rotate(-3deg);

        }

        .image:nth-child(3) {

            transform: translateX(20%) translateY(-20%) rotate(3deg);

        }

        .image:nth-child(2) {

            scale: 1.2;
            transform: translateY(-20%);

        }

    }

    .image {

        border-radius: 1em;
        position: absolute;

        transition: 0.4s var(--standard-transition-timing);

    }
    
    .image:nth-child(1), .image:nth-child(3) {

        top: 25%;
        scale: 0.6;
        z-index: 0;
        opacity: 0.5;

    }

    .image:nth-child(1) {

        background-color: chartreuse;
        left: 5%;

    }

    .image:nth-child(2) {

        background-color: blue;
        right: 25%;
        top: 25%;

        z-index: 1;

    }

    .image:nth-child(3) {

        background-color: brown;
        right: 5%;

    }

    .image {

        width: 50%;
        height: 50%;
        
        background-color: aqua;

    }


</style>