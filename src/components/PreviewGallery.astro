---
import type { ImageMetadata } from "astro";
import "../styles/global.css";
import { Image } from 'astro:assets';

interface Props {

    imageNames: string[];
    imageDirectory?: string;
    width?: string;
    height?: string;

}

const { imageNames, imageDirectory = "photography", width = "20%", height = "20%"} = Astro.props;

const images = import.meta.glob<{default: ImageMetadata}>('/src/assets/**/*.{jpeg,jpg,webp,png,gif}');

// console.log(images);

imageNames.forEach((name, i) => {

    imageNames[i] = `/src/assets/${imageDirectory}/${name}`

    console.log(imageNames[i]);

});

---

<div class="photo-gallery">

    <div class="image-box">

        {imageNames.map((image) =>

                <Image widths={[1200]} data-aspect-ratio={50} quality="medium" src={images[image]()} alt={"litty"} class="image"/>

        )}

    </div>

</div>

<script>

    import { previewAnimation } from "../scripts/previewManage";

    previewAnimation();

</script>


<style define:vars={{width, height}}>

    .photo-gallery {

        width: var(--width);
        height: var(--height);
        /* background-color: red; */
        position: relative;

    }

    .image-box {

        width: 100%;
        height: 100%;

        position: relative;

    }


    .image-box:has(.image:hover) .image:nth-child(1) {
        transform: translateX(-20%) translateY(-20%) rotate(-3deg);
        scale: 0.72;
        opacity: 0.8;
    }

    .image-box:has(.image:hover) .image:nth-child(3) {
        transform: translateX(20%) translateY(-20%) rotate(3deg);
        scale: 0.72;
        opacity: 0.8;
    }

    .image-box:has(.image:hover) .image:nth-child(2) {
        scale: 1.2;
        transform: translateY(-20%);
    }

    .image {

        border-radius: 1em;
        position: absolute;
        background-color: var(--custom-black-t);

        transition: 0.4s var(--standard-transition-timing);

        aspect-ratio: 16 / 9;
        width: calc(var(--width) * 0.5);
        height: calc(var(--height) * 0.5);

        object-fit: cover;

    }
    
    .image:nth-child(1), .image:nth-child(3) {

        top: 25%;
        scale: 0.6;
        z-index: 0;
        opacity: 0.5;

    }

    .image:nth-child(1) {

        left: 5%;

    }

    .image:nth-child(2) {

        right: 25%;
        top: 25%;

        z-index: 1;
        box-shadow: 0px 0px 10px var(--custom-black-t);

    }

    .image:nth-child(3) {

        right: 5%;

    }


</style>