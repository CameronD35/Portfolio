---
import "../styles/global.css";
import NavComponent from "./NavComponent.astro";
import { Icon } from 'astro-icon/components';
---

<div id="main-menu" class="nav-links">
    <div class="home-link">

        <NavComponent href="/" title="Home"/>
        
    </div>

    <div class="other-links">

        <NavComponent href="/about" title="About"/>
        <NavComponent title="Skills" isDropdown="true" containerName="skills" dropdownComponents={["Tutoring", "Software Engineering", "Graphic Design", "Photography"]}/>
        <NavComponent href="/experience" title="Experience"/>
        <NavComponent href="/blog" title="Blog"/>

        <div class="compressed-nav nav-title">

            <Icon name="Nav_Icon"></Icon>

        </div>

    </div>

</div>

<script>

    import { appendDropdown } from "../scripts/navManage";

    appendDropdown();

</script>

<style>

    .nav-links {

        width: 100vw;
        justify-content: space-between;
        max-height: 10vw;

    }

    a {

        color: var(--custom-white);

    }

    .compressed-nav {

        display: none;

    }

    @media screen and (max-width: 650px) {
        
        .compressed-nav {

            display: flex;
            justify-content: center;
            align-items: center;

        }

    }

    @keyframes hide-nav-titles {
        
        0% {

            

        }

    }



</style>