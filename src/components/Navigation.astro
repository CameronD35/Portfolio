---
import "../styles/global.css";
import NavComponent from "./NavComponent.astro";
import { Icon } from 'astro-icon/components';
---

<div id="main-menu" class="nav-links">
    <div class="home-link">

        <NavComponent href="/" title="Home"/>
        
    </div>

    <div class="other-links">

        <NavComponent href="/about" title="About" hide="true"/>
        <NavComponent title="Skills" isDropdown="true" containerName="skills" dropdownComponents={["Tutoring", "Software Engineering", "Graphic Design", "Photography"]} hide="true"/>
        <NavComponent href="/experience" title="Experience" hide="true"/>
        <NavComponent href="/blog" title="Blog" hide="true"/>

        <div class="compressed-nav nav-title">

            <Icon name="Nav_Icon"></Icon>

        </div>

    </div>

</div>

<script>

    import { appendDropdown, toggleNavElements } from "../scripts/navManage";

    appendDropdown();

     window.addEventListener("resize", toggleNavElements)

</script>

<style is:global>

    .nav-links {

        width: 100vw;
        justify-content: space-between;

    }

    a {

        color: var(--custom-white);

    }

    .compressed-nav {

        position: fixed;
        right: 0;
        opacity: 0;
        pointer-events: none;

        transition-duration: 0.4s;

    }

    @media screen and (max-width: 650px) {
        
        .compressed-nav {

            opacity: 1;
            pointer-events: all;

        }

    }



</style>