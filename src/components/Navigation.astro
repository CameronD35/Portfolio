---
import "../styles/global.css";
import NavComponent from "./NavComponent.astro";
import PopUpNavComponent from "./PopUpNavComponent.astro";
import { Icon } from 'astro-icon/components';
---

<div id="main-menu" class="nav-links">
    <div class="home-link">

        <NavComponent href="/" title="Home" icon="abbreviated-signature" fullIcon="signature" useIcon="true"/>
        
    </div>

    <div class="other-links">

        <NavComponent href="/about" title="About" hide="true"/>
        <NavComponent href="/tutoring" title="Tutoring" hide="true"/>
        <NavComponent title="Experience" isDropdown="true" containerName="experience" dropdownComponents={["Software Engineering", "Graphic Design", "Photography"]} hide="true"/>
        <NavComponent href="/blog" title="Blog" hide="true"/>

        <div class="compressed-nav-button nav-title">

            <Icon name="Nav_Icon"></Icon>

        </div>

    </div>

</div>

<div id="pop-up-main-menu" class="pop-up-nav-links">

    <PopUpNavComponent href="/about" title="About"/>
    <PopUpNavComponent href="/tutoring" title="Tutoring"/>
    <PopUpNavComponent title="Experience" isDropdown="true" containerName="experience" dropdownComponents={["Software Engineering", "Graphic Design", "Photography"]}/>
    <PopUpNavComponent href="/blog" title="Blog"/>

</div>

<script>

    import { toggleNavElements, popUpNav } from "../scripts/navManage";

    window.addEventListener("resize", toggleNavElements);

    window.dispatchEvent(new Event('resize'));

    const navButton = document.querySelector(".compressed-nav-button");

    console.log(navButton)

    navButton?.addEventListener("click", popUpNav);

</script>

<style is:global>

    .pop-up-nav-links {

        position: fixed;
        z-index: 4;
        opacity: 0;
        pointer-events: none;

        width: 100vw;
        height: 100vh;

        display: flex;
        flex-direction: column;

        justify-content: center;
        align-items: center;
        transform-origin: top;
        transition-duration: 50ms;

    }

    .pop-up-nav-links::after {

        content: "";
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        backdrop-filter: blur(10px);
        background-color: var(--custom-black-t);
        z-index: -1;

    }

    .pop-up-nav-links.open {

        opacity: 1;
        pointer-events: all;

    }
    
    .nav-links {

        width: 100vw;
        justify-content: space-between;

    }

    a {

        color: var(--custom-white);

    }

    .compressed-nav-button {

        position: fixed !important;
        right: 0;
        opacity: 0;
        pointer-events: none;

        transition-duration: 0.4s;

    }

    @media screen and (max-width: 750px) {
        
        .compressed-nav-button {

            opacity: 1;
            pointer-events: all;

        }

    }



</style>