---
import "../styles/global.css";
import NavComponent from "./NavComponent.astro";
import PopUpNavComponent from "./PopUpNavComponent.astro";
import { Icon } from 'astro-icon/components';
---

<div id="main-menu" class="nav-links">
    <div class="home-link">

        <NavComponent href="/" title="Home"/>
        
    </div>

    <div class="other-links">

        <NavComponent href="/about" title="About" hide="true"/>
        <NavComponent title="Skills" isDropdown="true" containerName="skills" dropdownComponents={["Tutoring", "Software Engineering", "Graphic Design", "Photography"]} hide="true"/>
        <NavComponent href="/experience" title="Experience" hide="true"/>
        <NavComponent href="/blog" title="Blog" hide="true"/>

        <div class="compressed-nav-button nav-title">

            <Icon name="Nav_Icon"></Icon>

        </div>

    </div>

</div>

<div id="pop-up-main-menu" class="pop-up-nav-links">

    <div class="home-link">

        <PopUpNavComponent href="/" title="Home"/>
        <PopUpNavComponent href="/about" title="About"/>
        <PopUpNavComponent title="Skills" isDropdown="true" containerName="skills" dropdownComponents={["Tutoring", "Software Engineering", "Graphic Design", "Photography"]}/>
        <PopUpNavComponent href="/experience" title="Experience"/>
        <PopUpNavComponent href="/blog" title="Blog"/>

    </div>

</div>

<script>

    import { toggleNavElements, popUpNav } from "../scripts/navManage";

    window.addEventListener("resize", toggleNavElements);

    window.dispatchEvent(new Event('resize'));

    const navButton = document.querySelector(".compressed-nav-button");

    navButton?.addEventListener("click", popUpNav);

</script>

<style is:global>

    .pop-up-nav-links {

        position: absolute;
        pointer-events: none;
        display: none;

        backdrop-filter: blur(5px);

        z-index: 4;

        width: 100vw;
        height: 100vh;

        /* display: flex;

        justify-content: center;
        align-items: center; */

    }

    .open {

        display: flex;

        justify-content: center;
        align-items: center;

        pointer-events: all;

    }
    
    .nav-links {

        width: 100vw;
        justify-content: space-between;

    }

    a {

        color: var(--custom-white);

    }

    .compressed-nav-button {

        position: fixed !important;
        right: 0;
        opacity: 0;
        pointer-events: none;

        transition-duration: 0.4s;

    }

    @media screen and (max-width: 650px) {
        
        .compressed-nav-button {

            opacity: 1;
            pointer-events: all;

        }

    }



</style>