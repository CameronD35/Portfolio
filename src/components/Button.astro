---
import "../styles/global.css"

interface Props {

    styleFlags?: Array<string>;
    bgColor?: string;
    textColor?: string;
    href?: string;

}

const {styleFlags = null, href = "/", bgColor = "var(--custom-black-t)", textColor = "var(--custom-white)"} = Astro.props;

const styleString = styleFlags?.join(" ");

// console.log(styleString);

---

<a href={href} class={`button ${styleString}`}>

    <div>

        <span class="text"><slot /></span>

    </div>

</a>

<style define:vars={{bgColor, textColor}}>

    a {

        text-decoration: none;
        color: var(--textColor);
        text-align: center;

    }

    .button {

        background-color: var(--bgColor);
        backdrop-filter: var(--minor-blur);
        position: relative;

        /* border: 2px solid var(--custom-white-st); */

        padding: 1em 2em;
        border-radius: 1.25em;

        display: flex;
        justify-content: center;
        align-items: center;

        transition: 0.5s var(--standard-transition-timing-no-bounce);

    }

    .leftOrigin {

        transform-origin: left;

    }

    .rightOrigin{

        transform-origin: right;

    }

    /* .button::after {

        content: '';
        position: absolute;
        width: 100%;
        height: 100%;
        border: 2px solid var(--custom-white-t);
        border-radius: calc(1.25em + 2px);

        opacity: 1;
        transition: 0.5s var(--standard-transition-timing-no-bounce);
        pointer-events: none;

    }

    .button:hover::after {

        scale: 1.5;

        filter: var(--BIG-blur);
        opacity: 0;


    } */

    .button:hover {

        scale: 1.2;
        box-shadow: 0px 0px 20px var(--custom-black-t);
        
    }

    .text {

        opacity: 0.7;
        transition-duration: 0.4s;

    }

    .button:hover .text {

        opacity: 1;

    }

    .fixed {

        position: absolute;
        bottom: 10%;

    }


    .big {

        .text {

            font-size: 1.5em;
            font-weight: 700;

        }

    }

    @media screen and (max-width: 850px) {

        .button {

            transform-origin: center !important;

        }

    }

</style>

