---
interface Props {

    platform?: string;
    username?: string;
    color?: string;
    hoverColor?: string;
    href?: string;

}


const { platform, username, color, hoverColor, href } = Astro.props;
---

{href && <a href={href} target="_blank"><slot/></a>}

{!href && <a href={`https://www.${platform.toLowerCase()}.com/${username}`} target="_blank"><slot/></a>}

<style define:vars={{color, hoverColor}}>
    a {

        padding: 0.5rem 1rem;
        color: var(--color);
        text-decoration: none;

        display: flex;
        justify-content: center;
        align-items: center;

        transition-duration: 0.2s;

    }

    a:hover {

        color: var(--hoverColor);

    }
    
</style>