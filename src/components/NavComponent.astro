---
interface Props {

    title: string;
    href?: string;
    isDropdown?: string;
    dropdownComponents?: Array<string>;
    containerName?: string;
    hide?: string;
    icon?: string;
    fullIcon?: string;
    classList?: string;
    useIcon?: string;

}

const { href, title, classList = "", isDropdown = "false", dropdownComponents = [], hide = "false", containerName, icon = null, useIcon = "false"} = Astro.props;
import { Icon } from "astro-icon/components";
import Dropdown from "./Dropdown.astro";

// console.log(icon);
---
<div class={"nav-component " + classList} data-nav={hide}>

    <a href={href} data-is-dropdown={isDropdown} data-title={title} class="nav-title">

        {useIcon == "false" && <span class="nav-link-title">

            {title}

        </span>}

        {(icon && useIcon) && <Icon name={icon} class="nav-icon"></Icon>}

        { (isDropdown === "true") && <Icon name="Dropdown_Arrow" class="arrow"/> }
    </a>

    { (isDropdown === "true") && <Dropdown containerName={`${containerName}`} components={dropdownComponents}/> }

</div>

<style>

    .nav-component {

        position: relative;
        width: auto;
        height: auto;

    }

    .arrow {

        height: 0.375em;
        width: auto;

    }

    [data-is-dropdown="true"] {

        span::after {

            display: none;

        }

        .nav-link-title {

            cursor: default;

        }

    }

</style>
