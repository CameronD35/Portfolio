---
interface Props {

    url: string;
    frontmatter: any;

}

const { url, frontmatter } = Astro.props;

// console.log(frontmatter)

const image = frontmatter?.image;

import { imageConfig } from "astro:assets";
import "../styles/global.css";
import Image from "astro/components/Image.astro";

// import bgImage from `${imageURL}`;

---

<li class="blog-post-card">
    <a href={url} class="blog-post-card-link">

        <div class="card">
            <span class="title">{frontmatter.title}</span>
            <span class="desc">{frontmatter.description}</span>
            <div class="bg-image">

                <img src={`../../src/images/${image.url?? "https://docs.astro.build/assets/rose.webp"}`} alt={image.alt?? "litty"}/>
                
            </div>
        </div>

    </a>
</li>

<style>

    .blog-post-card {

        padding: 1.5rem 0;
        

    }

    .blog-post-card-link {

        text-decoration: none;
        position: relative;

    }

    .title {

        font-size: 2em;
        font-weight: bold;
        color: var(--custom-white);
        transition: 0.5s var(--standard-transition-timing-no-bounce);
        transform-origin: left;

        z-index: 1;

    }

    .desc {

        font-size: 1em;
        font-weight: normal;
        color: var(--custom-white);
        transition: 0.5s var(--standard-transition-timing-no-bounce);
        transform-origin: left;

        z-index: 1;

    }

    .card {

        background-color: var(--custom-black-st);
        padding: 2em;
        padding-right: 40%;
        display: flex;
        flex-direction: column;
        border-radius: 2em;
        overflow: hidden;
        position: relative;
        background-size: cover;

        gap: 1em;


    }

    .blog-post-card:hover{

        .title, .desc {

            scale: 1.25;

        }

        .bg-image {

            scale: 1.1;

        }

        cursor: pointer;

    }

    .bg-image {

        position: absolute;
        width: 60%;
        height: 100%;
        top: 0;
        right: 0;
        transition: 0.5s var(--standard-transition-timing-no-bounce);
        transform-origin: right;
        mask: linear-gradient(to left, white 60%, transparent);

    }

    .bg-image img {
        width: 100%;

    }


</style>

