---
import { Icon } from "astro-icon/components";
import fs from 'fs';
import path from "path";
import "../styles/global.css";

interface Props {

    frontmatter: any;
    fileName: string;
}

const { frontmatter, fileName } = Astro.props;

const primary = frontmatter?.primaryColor?? "black";
const secondary = frontmatter?.secondaryColor?? "grey";
const tertiary = frontmatter?.tertiaryColor?? "white";
const quaternary = frontmatter?.quaternaryColor?? "blue";

const logoExists = fs.existsSync(
    path.resolve("src/icons", `${frontmatter.logo}.svg`)
);
---

<li class="project-card" data-color={primary}>

    <div class="card" data-title={fileName}>

        {logoExists && <Icon name={`${frontmatter.logo}`}/>}

        {!logoExists && <span class="title">{frontmatter.title}</span>}
        
        <span class="desc">{frontmatter.description}</span>

        <div class="arrow-box">

            <Icon name="Dropdown_Arrow" class="arrow"/>

        </div>

    </div>

</li>

<script>

    import projectCardAnimation from "../scripts/projectCardAnimation";

    projectCardAnimation();

</script>

<style define:vars={{primary, secondary, tertiary, quaternary}}>

    [data-icon] {

        height: 100%;
        width: 100%;
        max-width: 200px;
        transition: 0.5s var(--standard-transition-timing-no-bounce);
        transform-origin: left;

        z-index: 1;

    }

    .arrow-box {

        position: absolute;
        /* background-color: red; */
        top: calc(50% - 0.5em);
        right: 2em;

        display: flex;
        justify-content: center;
        align-items: center;

    }

    .arrow {

        color: var(--custom-white);
        transform-origin: center;
        height: 1em;
        transform: translateX(-6em) rotate(-90deg);

        opacity: 0;
        filter: var(--BIG-blur);

        animation: card-hover-end 0.8s var(--standard-transition-timing-no-bounce) forwards;

    }

    @keyframes card-hover-begin {

        from {

            transform: translateX(-6em) rotate(-90deg);
            opacity: 0;

        }

        to {

            transform: translateX(0em) rotate(-90deg);
            opacity: 1;

            filter: none;

        }

    }

    @keyframes card-hover-end {

        from {

            transform: translateX(0em) rotate(-90deg);
            opacity: 1;

            filter: none;

        }

        to {

            transform: translateX(6em) rotate(-90deg);
            opacity: 0;

            filter: var(--BIG-blur);

        }

    }

    .project-card {

        padding: 1.5rem 0;
        position: relative;
        

    }

    .title {

        font-size: 2em;
        font-weight: bold;
        color: var(--custom-white);
        transition: 0.5s var(--standard-transition-timing-no-bounce);
        transform-origin: left;

        z-index: 1;

    }

    .desc {

        font-size: 1em;
        font-weight: normal;
        color: var(--custom-white);
        transition: 0.5s var(--standard-transition-timing-no-bounce);
        transform-origin: left;

        z-index: 1;

    }

    .card {

        background-color: var(--custom-black-st);
        padding: 2em;
        padding-right: 20%;
        display: flex;
        flex-direction: column;
        border-radius: 2em;
        overflow: hidden;
        position: relative;
        background-size: cover;
        align-items: start;

        gap: 1em;

        transition:
            --secondary-1-x  1s var(--standard-transition-timing-no-bounce),
            --secondary-1-y  1s var(--standard-transition-timing-no-bounce),
            --secondary-2-x 1s var(--standard-transition-timing-no-bounce),
            --secondary-2-y 1s var(--standard-transition-timing-no-bounce),
            --secondary-3-x  1s var(--standard-transition-timing-no-bounce),
            --secondary-3-y  1s var(--standard-transition-timing-no-bounce),
            --tertiary-1-x     1s var(--standard-transition-timing-no-bounce),
            --tertiary-1-y     1s var(--standard-transition-timing-no-bounce),
            --tertiary-2-x     1s var(--standard-transition-timing-no-bounce),
            --tertiary-2-y     1s var(--standard-transition-timing-no-bounce),
            --tertiary-3-x   1s var(--standard-transition-timing-no-bounce),
            --tertiary-3-y   1s var(--standard-transition-timing-no-bounce),
            --quaternary-1-x     1s var(--standard-transition-timing-no-bounce),
            --quaternary-1-y     1s var(--standard-transition-timing-no-bounce),
            --quaternary-2-x     1s var(--standard-transition-timing-no-bounce),
            --quaternary-2-y     1s var(--standard-transition-timing-no-bounce),
            --quaternary-3-x   1s var(--standard-transition-timing-no-bounce),
            --quaternary-3-y   1s var(--standard-transition-timing-no-bounce);
            


    }

    .card:hover {

        cursor: pointer;

        .arrow {

            animation: card-hover-begin 0.8s var(--standard-transition-timing-no-bounce) forwards;

        }

        [data-icon] {

            scale: 1.15;
            filter: drop-shadow(0px 0px 5px var(--primary))

        }

        .desc, .title {

            scale: 1.15;
            text-shadow: 0px 0px 5px var(--primary);

        }

    }

    .card::after {

        content: '';
        position: absolute;
        top: -2.5%;
        left: -2.5%;
        z-index: -3;

        background-color: var(--primary);
        
        background-image:
            radial-gradient(at var(--quaternary-1-x)    var(--quaternary-1-y)    , var(--quaternary) 0px    , transparent 30%),
            radial-gradient(at var(--quaternary-2-x)    var(--quaternary-2-y)    , var(--quaternary) 0px    , transparent 30%),
            radial-gradient(at var(--quaternary-3-x)    var(--quaternary-3-y)    , var(--quaternary) 0px  , transparent 30%),
            radial-gradient(at var(--tertiary-1-x)    var(--tertiary-1-y)    , var(--tertiary) 0px    , transparent 30%),
            radial-gradient(at var(--tertiary-2-x)    var(--tertiary-2-y)    , var(--tertiary) 0px    , transparent 30%),
            radial-gradient(at var(--tertiary-3-x)    var(--tertiary-3-y)    , var(--tertiary) 0px  , transparent 30%),
            radial-gradient(at var(--secondary-1-x)   var(--secondary-1-y)  , var(--secondary) 0px  , transparent 30%),
            radial-gradient(at var(--secondary-2-x)   var(--secondary-2-y)  , var(--secondary) 0px  , transparent 30%),
            radial-gradient(at var(--secondary-3-x)   var(--secondary-3-y)  , var(--secondary) 0px    , transparent 30%);
            

        /* background-size: 200%; */

        aspect-ratio: 1 / 1;
        height: auto;
        width: 105%;

        /* filter: blur(12px); */

    }

    @property --secondary-1-x  { syntax: '<percentage>'; initial-value: 52%; inherits: true; }

    @property --secondary-1-y  { syntax: '<percentage>'; initial-value: 70%; inherits: true; }

    @property --secondary-2-x  { syntax: '<percentage>'; initial-value: 52%; inherits: true; }

    @property --secondary-2-y  { syntax: '<percentage>'; initial-value: 70%; inherits: true; }

    @property --secondary-3-x  { syntax: '<percentage>'; initial-value: 0%; inherits: true; }

    @property --secondary-3-y  { syntax: '<percentage>'; initial-value: 0%; inherits: true; }

    @property --tertiary-1-x   { syntax: '<percentage>'; initial-value:  72%; inherits: true; }

    @property --tertiary-1-y   { syntax: '<percentage>'; initial-value:  74%; inherits: true; }

    @property --tertiary-2-x   { syntax: '<percentage>'; initial-value: 18%; inherits: true; }

    @property --tertiary-2-y   { syntax: '<percentage>'; initial-value: 37%; inherits: true; }

    @property --tertiary-3-x   { syntax: '<percentage>'; initial-value: 88%; inherits: true; }

    @property --tertiary-3-y   { syntax: '<percentage>'; initial-value: 50%; inherits: true; }

    @property --quaternary-1-x   { syntax: '<percentage>'; initial-value:  46%; inherits: true; }

    @property --quaternary-1-y   { syntax: '<percentage>'; initial-value:  82%; inherits: true; }

    @property --quaternary-2-x   { syntax: '<percentage>'; initial-value: 92%; inherits: true; }

    @property --quaternary-2-y   { syntax: '<percentage>'; initial-value: 21%; inherits: true; }

    @property --quaternary-3-x   { syntax: '<percentage>'; initial-value: 95%; inherits: true; }

    @property --quaternary-3-y   { syntax: '<percentage>'; initial-value: 24%; inherits: true; }

</style>