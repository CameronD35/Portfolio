---
import BaseLayout from "./BaseLayout.astro";
import 'katex/dist/katex.css';
import "../styles/global.css"
import type { ImageMetadata } from "astro";
import { Image } from 'astro:assets';


const { frontmatter } = Astro.props;

const images = import.meta.glob<{default: ImageMetadata}>('/src/assets/blogs/*.{webp,jpeg,jpg,png,gif}');

const image = frontmatter?.image.url;

console.log(image)

if (!images[image]) throw new Error(`"${image}" does not exist in glob: "src/assets/blogs/*.{webp,jpeg,jpg,png,gif}"`);

const postDate = new Date(frontmatter.pubDate);

const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

const dateStr = `${months[postDate.getMonth()]} ${postDate.getDate() + 1}, ${postDate.getFullYear()}`;

---

<BaseLayout pageTitle={frontmatter.title}>

    <div class="post-content-container">
        <div class="banner">

            <div class="info">

                <span class="title">{frontmatter.title}</span>
                <span class="author">{frontmatter.author}</span>

            </div>

            <div class="date-tags-container">

                <span class="date">{dateStr}</span>
                
                <div class="tags">
                    
                    <span>Tags: {frontmatter.tags.join(", ")}</span>

                </div>
                
            </div>

            <div class="bg-image">

                <Image src={images[image]()} alt={image.alt?? "litty"} class="img"/>
                
            </div>

        </div>

        <div class="script">

            <slot />

        </div>

    </div>

</BaseLayout>

<style is:global>

    @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Oi&display=swap');

    figure {

        margin-left: 0.25em;
        margin-right: 0.25em;

    }

    pre {

        padding: 2em;
        border-radius: 1.5em;
        position: relative;


    }

    code {

        font-family: "JetBrains Mono", monospace;
        font-size: 0.9em;

    }

    pre::after {

        content: attr(data-language);
        text-transform: uppercase;
        position: absolute;
        top: 1.5em;
        right: 1.5em;
        color: var(--custom-white-st);
        font-family: "JetBrains Mono", monospace;
        font-size: 0.9em;
        z-index: 2;

    }

    pre code span {

        font-family: "JetBrains Mono", monospace;
        font-size: 0.9em;

    }

    a {

        color: #00539F;

    }

    .bg-image {

        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        right: 0;
        transition: 0.5s var(--standard-transition-timing-no-bounce);
        transform-origin: right;

    }

    .img {

        width: 100%;
        height: auto;

    }

    .tags {
        
        display: flex;
        flex-wrap: wrap;

        align-items: center;

    }

    .tag a {

        color: var(--custom-white);

        font-size: 1em;

        margin: 0 0em 0 0.5em;

        text-decoration: none;
        font-style: italic;

    }

    .info {

        padding: 1.5em;
        max-width: 50%;

        color: var(--custom-white);

        z-index: 1;
        display: flex;
        flex-direction: column;
        cursor: default;

    }

    .date-tags-container {

        padding: 1.5em;
        max-width: 50%;

        color: var(--custom-white);

        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: end;
        text-align: right;
        cursor: default;

    }

    .title {

        font-size: 2em;
        font-weight: 700;

    }
    .author {

        font-size: 1em;
        font-style: italic;

    }

    .banner {

        width: calc(100vw - 10em);
        height: 10em;

        background-position: 0% 0%;
        background-size: cover;
        
        position: relative;

        display: flex;
        align-items: end;
        justify-content: space-between;

        border-radius: 2em;
        overflow: hidden;

        box-shadow: 0px 0px 15px var(--custom-black-t);

    }

    .banner::after {

        content: '';
        position: absolute;

        bottom: 0%;

        height: 100%;
        width: 100%;

        background-color: var(--custom-black-t);

        background-image: linear-gradient(to top, var(--custom-black-st) 20%, rgba(0,0,0,0));

    }

    .post-content-container {

        padding: 4em 5em 0em 5em;

        display: flex;
        flex-direction: column;
        align-items: center;

    }

    .script {

        padding: 1em 8em;

    }

    .tags {

        display: flex;
        justify-content: right;

    }

</style>