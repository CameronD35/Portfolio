---
import BaseLayout from '../../layouts/BaseLayout.astro';
import "../../styles/global.css"

import bgImage from "../../images/tutoring-bg.webp";
import Button from '../../components/Button.astro';
import { Icon } from 'astro-icon/components';
import { actions } from 'astro:actions';
import { isInputError } from 'astro:actions';

const worksheets = Object.keys(import.meta.glob('/public/pdfs/tutoring/*.pdf'));

worksheets.forEach((i) => {

	console.log(i.substring(i.indexOf('/', 2)));

});

const statements = [

	{
		author: "Jesse Cruz",
		social: "https://www.instagram.com/jessecruz07/",
		title: "College of the Canyons MESA Tutor Lead",
		statement: `Cameron is one of the best tutors the MESA Center has ever had. 
		He always goes the extra mile to make sure every student understands the concepts. 
		He is patient, adaptable, approachable, and kind to everyone he tutors. He breaks 
		down important concepts and makes even the most difficult ones easy for students to 
		understand. If you need help with upper-division classes, he is the person you want tutoring you.`
	}

]

const courses: Record<string, string> = {
	"Linear Algebra": "An introduction to vector spaces, inner products, and mathematical proofs.",
	"Differential Equations": "Techniques for solving ordinary differential equations.",
	"Multi-Variable Calculus": "Derivatives, integrals, and the study of change in three dimensions or higher.",
	"Calculus": "Derivatives, integrals, and the study of change.",
	"Pre-Calculus": "Advanced algebra and trigonometric techniques.",
	"Trigonometry": "The study of periodic functions, angles, and geometries.",
	"Mechanics of Solids & Fluids": "The study of linear and rotational kinematics and kinetics.",
	"Electricity & Magnetism": "The study of electromagnetic fields and circuits.",
	"Engineering Statics": "The study of rigid structures.",
	"Data Structures & Algorithms (Java)": "The study of data storage, access, and structures in Object-Oriented Programming.",
	"General Chemistry": "Introduction to stoichiometry, equilibria, and chemical reactions.",
}

const options: Record<string, Array<string>> = {
	"High School": ["Calculus AB / BC", "Algebra I", "Algebra II", "Trigonometry", "Geometry", "Chemistry / AP Chemistry", "Physics / AP Physics"],
	"College": ["Calculus I", "Calculus II", "Multi-Variable Calulus (Calculus III)", "Differential Equations", "Linear Algebra", "Physics: Mechanics (General Physics I)",
		"Physics: Electricity & Magnetism (General Physics II)", "Modern Physics: Thermodynamics, Optics, Relativity & Quantum Mechanics", "General Chemistry I", "General Chemistry II"
	],
};

const pageTitle = "Tutoring";

const result = Astro.getActionResult(actions.send);

if (result?.data) { return Astro.redirect("/tutoring"); }

const inputErrors = isInputError(result?.error) ? result.error.fields : {};

---

<BaseLayout pageTitle={pageTitle}>

	<div class="chalkboard" style={`background-image: url(${bgImage.src})`}>
		<canvas class="drawing-board"></canvas>
	</div>
	
	<div class="std-content-box no-select">

		<h1>Tutoring</h1>
		<h4>You may be here because you saw that I am a private tutor in San Luis Obispo, California, or maybe you're curious about my experience!</h4>

		<div class="section-title">What is my Experience?</div>

		<p>
			For (almost exactly) one year, I worked as a Mathematics & Physics Tutor in Santa Clarita, California, where I racked up over <b>1000 hours</b> of work. My workplace (but really my home) was the MESA
			center at <a href="https://www.canyons.edu">College of the Canyons</a>, where I mentored students through the following subjects:
		</p>

		<br>

		<div class="subjects">

			{Object.keys(courses).map((course: string, i) => {

				return (
					<div class="course-container">
						<div class="course">{course}</div>
						<div class="tooltip">{courses[course]}</div>
					</div>
				)

			})}

		</div>

		<br>

		<p>
			Beyond my time at MESA I have spent <b>over 50 hours</b> private tutoring the same subjects not including the years of helping my younger sister with K-12 mathematics. Now that I am transferring to the California Polytechnic University, San Luis Obispo (or Cal Poly SLO), I hope to continue to help mathematics and physics students.
		</p>

		<br>

		<p>
			Here are some statements from those who I have worked with before:
		</p>

		<br>

		<div class="statement">
			{statements.map((statement) => {

				return <div class="quote">
						<Icon name="quotation-left" class="mark-left"/>
						{statement.statement}
						<Icon name="quotation-right" class="mark-right"/>
					</div>
					<div class="author">
						<a href={statement.social}>- {statement.author}</a>
						<span>, {statement.title}</span>
					</div>

			})}
		</div>

		<br>

		<div class="section-title">Interested in Booking Some Time?</div>

		<p>
			Please feel free to send me an email:
		</p>

		<form action={actions.send} method="post">

			<fieldset>
				<legend>What is your name?</legend>

				<input type="text" name="name" placeholder="Name" required aria-describedby={inputErrors.name ? "name-error" : undefined}>
				{inputErrors.name && <p id="name-error">{inputErrors.name[0]}</p>}
			</fieldset>

			<fieldset>
				<legend>Which email do you wish to communicate with?</legend>
				<input type="email" name="email" placeholder="Email" required aria-describedby={inputErrors.email ? "email-error" : undefined}>
				{inputErrors.email && <p id="email-error">{inputErrors.email[0]}</p>}
			</fieldset>

			<fieldset class="courses-box">
				<legend>What education level are you?</legend>
				{Object.keys(options).map((educationLevel) => {

					const formattedEducationLevel = educationLevel.replaceAll(" ", "-").toLowerCase();
					console.log(formattedEducationLevel);

					return <label class="option education-level">{educationLevel}
									<input type="radio" id={formattedEducationLevel} name="level" value={educationLevel} style="text-transform: capitalize;" aria-describedby={inputErrors.level ? "level-error" : undefined}/>
									<span class="radio-circle"></span>
							</label>	

				})}
				{inputErrors.level && <p id="level-error">{inputErrors.level[0]}</p>}
			</fieldset>

			<fieldset class="courses-box">
				<legend>What course(s) are looking for help in?</legend>

				<span class="select-one" data-visible="true">Please select an education level!</span>

				{Object.keys(options).map((educationLevel) => {

					const formattedEducationLevel = educationLevel.replaceAll(" ", "-").toLowerCase();

					return <div class={`${formattedEducationLevel} level`} style="display: none">

						{options[educationLevel].map((option) => {

							const formattedOption = option.toLowerCase().replaceAll(" ", "-");

							return <label class="option">{option}
									<input type="checkbox" id={formattedOption} name="courses" value={option} aria-describedby={inputErrors.courses ? "courses-error" : undefined}/>
									<span class="checkmark"></span>
							</label>	

						})}

					</div>

				})}
				{inputErrors.courses && <p id="courses-error">{inputErrors.courses[0]}</p>}
			</fieldset>

			<fieldset>
				<legend>Wish to add anything else?</legend>
				<textarea name="body" rows="4" placeholder="Feel free to describe your goals in detail, describe your availability, etc." required aria-describedby={inputErrors.body ? "body-error" : undefined}></textarea>
				{inputErrors.body && <p id="body-error">{inputErrors.body[0]}</p>}
			</fieldset>

			<button>Send Email</button>
		</form>

		<br><br>

		<div class="section-title">Interested in Some Worksheets?</div>

		<div class="worksheet-button">
			Coming Soon!
			<!-- <Button styleFlags={["big", "leftOrigin"]} bgColor="var(--custom-white-t)" textColor="var(--custom-black)" href="/tutoring/worksheets">Check them out here!</Button> -->
		</div>

	</div>
	
</BaseLayout>

<script>

	import { initializeCanvas } from "../../scripts/drawingBoard";

	initializeCanvas();

	document.documentElement.style.setProperty("--nav-color", "var(--custom-white-st)");
	document.documentElement.style.setProperty("--nav-bg-color", "#000000");
	document.documentElement.style.setProperty("--footer-color", "#00000000");
	document.documentElement.style.setProperty("--footer-accent", "#5c5c5c");
	document.documentElement.style.setProperty("--footer-accent-hover", "#888888");

	// const drawingResolution = 30;

	const courseContainers = document.querySelectorAll(".course-container");

	courseContainers.forEach((container) => {

		const course = container.querySelector(".course");
		const tooltip = container.querySelector(".tooltip");

		container?.addEventListener("mouseenter", () => {

			// console.log("enter");

			course?.animate([{transform: `scale(0.5)`, opacity: 0, filter: "blur(5px)"}], {duration: 400, fill: "forwards", easing: "cubic-bezier(0.175, 0.885, 0.32, 1.0)"});
			tooltip?.animate([{transform: `scale(1)`, opacity: 1, filter: "none"}], {duration: 400, fill: "forwards", easing: "cubic-bezier(0.175, 0.885, 0.32, 1.0)"});

		})

		container?.addEventListener("mouseleave", () => {

			// console.log("leave");

			course?.animate([{transform: `scale(1)`, opacity: 1, filter: "none"}], {duration: 400, fill: "forwards", easing: "cubic-bezier(0.175, 0.885, 0.32, 1.0)"});
			tooltip?.animate([{transform: `scale(0)`, opacity: 0, filter: "blur(5px)"}], {duration: 400, fill: "forwards", easing: "cubic-bezier(0.175, 0.885, 0.32, 1.0)"});

		})

	});

	const educationLevels: NodeListOf<HTMLElement> = document.querySelectorAll(".education-level input");

	const selectOne: HTMLElement = document.querySelector(".select-one")!;

	console.log(educationLevels)

	educationLevels.forEach((level, i) => {

		console.log("text")

		level.addEventListener("change", (evt: any) => {

			const choice: HTMLElement = document.querySelector(`.${level.id}`)!;
			

			// if (evt.target.checked) { console.log(choice + " is checked"); }
			// else { console.log(level.id + " is unchecked"); }

			if (level.id === "high-school") {document.querySelector(`.college`)!.style.display = "none";}
			if (level.id === "college") {document.querySelector(`.high-school`)!.style.display = "none";}

			choice.style.display = "block";
			selectOne.style.display = "none";

		});

	});
	


</script>

<style>

	.select-one {

		color: var(--custom-white-t);
		font-family: "Inter", sans-serif;
		font-size: 1.25em;
		font-weight: 600;

		[data-visible="true"] {

			opacity: 1;

		}

		[data-visible="false"] {

			opacity: 0;

		}

	}

	button {

        background-color: transparent;
        backdrop-filter: var(--minor-blur);
        position: relative;

        border: 2px solid var(--custom-white-st);
		color: var(--custom-white-st);

        padding: 1em 2em;
        border-radius: 0.5em;

        display: flex;
        justify-content: center;
        align-items: center;

        transition: 0.4s var(--standard-transition-timing-no-bounce);
		font-family: "Inter", sans-serif;
		font-weight: 600;

	}

	button:hover {

		cursor: pointer;
		background-color: var(--custom-white-st);
		color: var(--custom-black);

	}

	.courses-box div, .courses-box {
		
		display: flex;
		flex-wrap: wrap;
		justify-content: start;
		gap: 1em 4em;

	}

	.option {

		display: flex;
		flex-direction: row;
		align-items: center;
		position: relative;
		margin-left: 0.5em;
		padding-left: 2.5em;
		margin-bottom: 1em;
		cursor: pointer;
		-webkit-user-select: none;
		-moz-user-select: none;
		-ms-user-select: none;
		user-select: none;
		transition-duration: 400ms;

	}

	.option input {
		position: absolute;
		opacity: 0;
		cursor: pointer;
		height: 0;
		width: 0;
	}

	.checkmark {
		position: absolute;
		top: 0;
		left: 0;
		height: 25px;
		width: 25px;
		background-color: var(--custom-white-st);
		transition: 200ms var(--standard-transition-timing-no-bounce);
		border-radius: 0.25em;
	}

	.radio-circle {

		position: absolute;
		top: 0;
		left: 0;
		height: 25px;
		width: 25px;
		background-color: var(--custom-white-st);
		transition: 200ms var(--standard-transition-timing-no-bounce);
		border-radius: 100%;

	}

	.radio-circle:after {
		content: "";
		position: absolute;
		transition: 600ms var(--standard-transition-timing-no-bounce);
		opacity: 0;

		transform: scale(2);
		filter: blur(2px);

	}

	.option input:checked ~ .radio-circle:after {
		opacity: 1;
		filter: blur(0px);
		transform: scale(1);
		box-shadow: 0px 0px 5px var(--custom-light-blue-st);
	}

	.option .radio-circle:after {
		width: 25px;
		height: 25px;
		background-color: var(--custom-light-blue);
		border-radius: 100%;
	}

	/* CHECKBOX CODE ADAPTED FROM: https://www.w3schools.com/howto/howto_css_custom_checkbox.asp */

	.option:hover input ~ .checkmark {
		background-color: var(--custom-white);
	}

	.option input:checked ~ .checkmark {
		background-color: var(--custom-light-blue);
		box-shadow: 0px 0px 5px var(--custom-light-blue-st);

	}


	.checkmark:after {
		content: "";
		position: absolute;
		transition: 600ms var(--standard-transition-timing-no-bounce);
		opacity: 0;

		transform: rotate(45deg) scale(2);
		filter: blur(2px);

	}

	.option input:checked ~ .checkmark:after {
		opacity: 1;
		filter: blur(0px);
		transform: rotate(45deg) scale(1);
	}

	.option .checkmark:after {
		left: 9px;
		top: 5px;
		width: 5px;
		height: 10px;
		border: solid var(--custom-white);
		border-width: 0 3px 3px 0;
		border-radius: 2px;
		-webkit-transform: rotate(45deg);
		-ms-transform: rotate(45deg);
		transform: rotate(45deg);
	}

	form {

		display: flex;
		flex-direction: column;
		gap: 1em;

	}

	label {

		display: flex;
		flex-direction: column;
		gap: 0.25em;

	}

	fieldset {

		background-color: transparent;
		border: 2px solid var(--custom-white-st);
		border-radius: 0.5em;

		color: var(--custom-white-st);
		font-family: "Inter", sans-serif;

		margin: 0;
		
	}

	input[type="text"], input[type="email"], textarea {

		background-color: transparent;
		border: none;
		width: 100%;
		color: var(--custom-white-st);
		font-family: "Inter", sans-serif;
		font-size: 1.25em;
		font-weight: 600;
		transition-duration: 200ms;


	}

	input[type="text"]:focus, input[type="email"]:focus, textarea:focus {

		color: var(--custom-white);

	}

	input[type="text"]::placeholder, input[type="email"]::placeholder, textarea::placeholder {

		color: var(--custom-white-t);

	}

	textarea {

		resize: none;

	}

	input[type="checkbox"] {

		background-color: transparent;

	}

	.chalkboard {

		content: '';
		position: fixed;
		inset: -10px;
		
		background-size: cover;
		
		z-index: -1;

		pointer-events: none;

	}

	.drawing-board {

		filter: var(--BIG-blur);

		width: 100vw;
		height: 100vh;
		inset: 10px;
		position: absolute;

	}

	.std-content-box {
		
		position: relative;

		color: var(--custom-white-st);
		
		z-index: 1;

	}

	.section-title {

		font-size: 2em;
		font-weight: 700;

	}

	.subjects {
		
		margin: 2em 0;
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1em;

	}

	.course-container {

		flex: 0 0 300px;
		font-weight: 600;
		text-align: center;
		position: relative;
		pointer-events: all;

	}

	.tooltip {

		color: var(--custom-white-st);
		font-size: 0.75em;
		text-align: center;
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transform: scale(0);

		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 1;

		transition-duration: 0.4s;

	}

	.mark-left[data-icon], .mark-right[data-icon] {

		font-size: 0.5em;
		color: var(--custom-white-st);
		transform: translateY(-1em);

	}

	.mark-left {

		margin-right: 10px;

	}

	.mark-right {

		margin-left: 10px;

	}

	.quote {

		font-weight: 500;
		font-size: 1.5em;

	}

	.author {

		margin-top: 0.5em;
		text-align: left;
		
	}

	.author a {

		text-decoration: none;
		font-style: italic;
		font-weight: 700;
		color: var(--custom-white-st);

	}

	.author span {

		font-weight: 700;
		color: var(--custom-white-st);

	}

	.worksheet-button {

		display: flex;
		margin: 1em 0;

	}

	.statement {

		display: flex;
		flex-direction: column;
		width: fit-content;
			
	}

	@media screen and (max-width: 850px) {
        
        h1, h4, .section-title {

            text-align: center;

        }

		.worksheet-button {

			justify-content: center;

		}

    }

</style>