---
import BaseLayout from '../../layouts/BaseLayout.astro';
import "../../styles/global.css"

import bgImage from "../../images/tutoring-bg.webp";
import PDFViewer from '../../components/PDFViewer.jsx';

const worksheets = Object.keys(import.meta.glob('/public/pdfs/tutoring/*.pdf'));

worksheets.forEach((i) => {

	console.log(i.substring(i.indexOf('/', 2)));

})

const pageTitle = "Worksheets";
---


<BaseLayout pageTitle={pageTitle}>
	
	<div class="std-content-box no-select">

		<h1>Worksheets</h1>
		<h4>Showcased here is some of my most proud work. Everything here is free to download (and hopefully helpful)!</h4>

        <div class="worksheet-container">
            {worksheets.map((worksheet: string, i) => {
                if (i % 2 != 0) {

                    return <div class="worksheet-section left">
                        <span>name</span>
                        <PDFViewer url={worksheet.substring(worksheet.indexOf('/', 2))} client:only="react"></PDFViewer>
                    </div>

                } else {

                    return <div class="worksheet-section right">
                        <span>name</span>
                        <PDFViewer url={worksheet.substring(worksheet.indexOf('/', 2))} client:only="react"></PDFViewer>
                    </div>

                }
            })}
        </div>

	</div>
	
</BaseLayout>

<script>

	import { setFooterFixing } from "../../scripts/footerManage";
	import { initializeCanvas } from "../../scripts/drawingBoard";

	initializeCanvas();

	document.documentElement.style.setProperty("--nav-color", "var(--custom-white-st)");
	document.documentElement.style.setProperty("--nav-bg-color", "#000000");
	document.documentElement.style.setProperty("--footer-color", "#00000000");
	document.documentElement.style.setProperty("--footer-accent", "#5c5c5c");
	document.documentElement.style.setProperty("--footer-accent-hover", "#888888");

	(document.querySelector(".footer") as HTMLElement)?.style.setProperty("display", "none");
	
	setTimeout(() => {

		setFooterFixing();
		console.log('hi');
		(document.querySelector(".footer") as HTMLElement)?.style.setProperty("display", "flex");

	}, 1000);

	const drawingResolution = 30;
	

</script>

<style>

	.std-content-box {
		
		position: relative;

		color: var(--custom-black);
		
		z-index: 1;

	}

	.worksheet-container {

		display: flex;
        flex-direction: column;
		gap: 1em;

	}

    .worksheet-section {

        padding: 0.5em;
		position: relative;
        display: flex;
		/* gap: 2em; */
		justify-content: space-between;
		align-items: center;
		border-radius: 1.5em;
		border-style: dashed;

		transition: 0.4s;

    }

    .left {

        flex-direction: row;
        
    }

    .right {

        flex-direction: row-reverse;
        
    }

	.stats-container div:hover {

		box-shadow: 0 0 10px var(--custom-black-t);

	}

	.mesa-hours {

		grid-row: 1 / 3;
		grid-column: 1 / 3;
		display: flex;
		flex-direction: column;

	}

	.private-hours {

		grid-row: 1 / 3;
		grid-column: 3 / 5;
		display: flex;
		flex-direction: column;

	}

	.subjects {

		grid-column: 1 / 5;
		display: flex;
		flex-direction: column;
		flex-wrap: wrap;

	}

	.files {

		grid-column: 1 / 5;
		display: flex;
		flex-direction: column;

	}

	.file-container {

		padding: 2em 0;

		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		max-width: 100%;

		place-items: center;
		place-content: center;
		padding-inline-start: 0;

		gap: 2em;

	}

	.big-number {

		font-size: 6em;
		font-weight: 900;

	}

	.stat-desc {

		font-size: 1.5em;
		text-align: center;

	}

	.tutor-class-experience {

		display: grid;
		list-style-type: none;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		max-width: 100%;

		place-items: center;
		place-content: center;
		padding-inline-start: 0;

		gap: 2em;

	}

	.exp {

		font-weight: 600;

	}

	@media screen and (max-width: 850px) {
        
        h1, h4 {

            text-align: center;

        }

    }

</style>

