---
import DesignTheme from '../../components/DesignTheme.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import "../../styles/global.css";

// https://stackoverflow.com/questions/18112204/get-all-directories-within-directory-nodejs

// const directories = (parent: any) => {

// 		fs.readdirSync(parent, { withFileTypes: true }).reduce((a: any[], c: any) => {

// 			c.isDirectory() && a.push(c.name);
// 			return a;

// 		}, [])

// }

const themes: Record<string, string> = {

	'justin-bieber': 'This is THE Bustin Jieber.',
	'atomalis': 'All of my designs for the RockSat 2026 ATOMALiS project.',
	'goofy': 'I like to have fun with my designs sometimes...',
	'atlas': 'All of my RockSat ATLAS related designs.',
	'marztg': 'All of my designs related to my gaming YouTube channel (formerly Mario Stereo).',

}

const colors = ['#3d1745', '#c48d0b', 'var(--custom-black)', '#451718', '#17451b'];

const pageTitle = "Graphic Design";
---

<BaseLayout pageTitle={pageTitle}>
	
	<div class="bg"></div>
	<div class="bg-bottom"></div>

	<div class="std-content-box">

		<h1>Graphic Design</h1>

		<h4>Below are some general themes for some of my favorite designs!</h4>

		<ul class="theme-list">
			{Object.keys(themes).map((theme: any, i) => {

				return <DesignTheme title={theme} desc={themes[theme]} color={colors[i]}/>

			})}
		</ul>

	</div>
	
</BaseLayout>

<script>

	import { setThemeAssetScroll } from "../../scripts/themeManage";

    setThemeAssetScroll();

    const cards = document.querySelectorAll(".card");
	const bg: HTMLElement = document.querySelector(".bg")!;
	const bgBottom: HTMLElement = document.querySelector(".bg-bottom")!;

    cards?.forEach((card: any, i) => {

		let color: string = card.computedStyleMap().get("--color")[0];

        card.addEventListener("mouseenter", () => {

			bg.style.backgroundColor = color;
			bgBottom.style.backgroundColor = color;

			bg.animate([{transform: `scaleY(0.5)`, filter: 'none'}], {duration: 400, fill: "forwards", easing: "cubic-bezier(0.175, 0.885, 0.32, 1.0)"});
			bgBottom.animate([{transform: `scaleY(0.5)`, filter: 'none'}], {duration: 400, fill: "forwards", easing: "cubic-bezier(0.175, 0.885, 0.32, 1.0)"});
			card.style.boxShadow = `0px 0px 20px var(--custom-black-t)`

			document.documentElement.style.setProperty("--nav-color", "var(--custom-white)");
			document.documentElement.style.setProperty("--nav-bg-color", "var(--custom-black-t)");
			document.documentElement.style.setProperty("--footer-color", color);
			document.documentElement.style.setProperty("--footer-accent", "var(--custom-white)");

			document.querySelector("h1")!.style.color = 'var(--custom-white)'
			document.querySelector("h4")!.style.color = 'var(--custom-white)'


        });

		card.addEventListener("mouseleave", () => {

			console.log(color);

			bg.style.backgroundColor = color;
			bgBottom.style.backgroundColor = color;

			bg.animate([{transform: `scaleY(0)`, filter: 'blur(5px)'}], {duration: 400, fill: "forwards", easing: "cubic-bezier(0.175, 0.885, 0.32, 1.0)"});
			bgBottom.animate([{transform: `scaleY(0)`, filter: 'blur(5px)'}], {duration: 400, fill: "forwards", easing: "cubic-bezier(0.175, 0.885, 0.32, 1.0)"});

			document.documentElement.style.setProperty("--nav-color", "var(--custom-black)");
			document.documentElement.style.setProperty("--nav-bg-color", "var(--custom-white-t)");
			document.documentElement.style.setProperty("--footer-color", "var(--custom-white)");
			document.documentElement.style.setProperty("--footer-accent", "var(--custom-black-st)");
			document.documentElement.style.setProperty("--footer-accent-hover", "var(--custom-black)");

			document.querySelector("h1").style.color = 'var(--custom-black)'
			document.querySelector("h4").style.color = 'var(--custom-black)'

        });

    })

</script>

<style>

	.bg {

		position: fixed;
		width: 100vw;
		height: 100vh;

		filter: blur(5px);

		z-index: -1;

		transform-origin: top;
		transform: scaleY(0);

	}

	.bg-bottom {

		position: fixed;
		width: 100vw;
		height: 100vh;

		filter: blur(5px);

		z-index: -1;

		transform-origin: bottom;
		transform: scaleY(0);

	}

	.theme-list {

        display: flex;
        flex-direction: column;
		list-style-type: none;
        padding: 0;
		margin-left: -2em;
		margin-right: -2em;
        display: flow-root;


    }

	@media screen and (max-width: 850px) {
        
        h1, h4 {

            text-align: center;

        }

    }

</style>