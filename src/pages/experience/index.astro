---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro'

const allProjects = Object.values(import.meta.glob(['../experience/*.md', '../experience/*.mdx'], { eager: true }));
console.log("projects: ", allProjects);
const pageTitle = "Experience";
---

<BaseLayout pageTitle={pageTitle}>

	<div class="overlay">


		
	</div>

    <div class="project-content-box">
        <h1>Experience</h1>

        <ul class="project-list">
            
            {allProjects.map((project: any) => <ProjectCard frontmatter={project.frontmatter}/>)}

        </ul>

    </div>
    
</BaseLayout>

<style>

    .project-content-box {

        padding: 4em 2em 0em 2em;

    }

    .project-content-box ul {

        list-style-type: none;
        padding: 0;
        display: flow-root;

    }

    .project-list {

        display: flex;
        flex-direction: column;

    }

</style>