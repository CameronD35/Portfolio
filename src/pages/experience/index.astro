---
import BaseLayout from '../../layouts/BaseLayout.astro';
import YearBox from '../../components/YearBox.astro';
import { Icon } from "astro-icon/components";
import "../../styles/global.css";
import { readdirSync, statSync } from 'fs';
import { join } from 'path';

const allProjects = Object.values(import.meta.glob(['../../content/experiences/*.md', '../../content/experiences/*.mdx'], { eager: true }));

let projectsByYears: Record<string, any[]> = {};
let currentProjects: any[] = [];

allProjects.forEach((project: any, i) => {

    const isCurr = (project.frontmatter.curr == "true");

    const year = String(project.frontmatter?.year);

    if (isCurr) {currentProjects.push(project); return;}

    if (projectsByYears[year]) { projectsByYears[year].push(project); }

    else { projectsByYears[year] = [project]; }

});

console.log("curr: ", currentProjects);

const sortedYears = Object.keys(projectsByYears).sort((a,b) => Number(b) - Number(a));

// console.log(sortedYears);

let sortedProjects: [string, any[]][] = sortedYears.map(

    year => [year, projectsByYears[year]]

);

// lets get those pdf files
const pdfDirectory = join(process.cwd(), 'public/pdfs');

const pdfFiles = readdirSync(pdfDirectory)
    .filter((file) => { return file.endsWith('.pdf')})
    .map((file) => ({

        name: file,
        url: `pdfs/${file}`

    }));

console.log(pdfFiles)

const pageTitle = "Experience";
---

<BaseLayout pageTitle={pageTitle}>
    
    <div class="experience-content-box">

        <div class="section-container" data-details="false">

            <div class="projects-section">
            
                <h1>Experience</h1>
                
                {currentProjects.length > 0 && <YearBox year="ONGOING" experiences={currentProjects}/>}

                {sortedProjects.map(([year, projects]) => <YearBox year={year} experiences={projects}/>)}
                
            </div>

            <div class="details-section">

                <div class="title-and-company">

                        <div class="details-title"></div>
                        <div class="details-company"></div>

                </div>

                <div class="description-and-materials">

                    <div class="description">

                        {allProjects.map((project: any) => {

                            return <div class="mdx-body" data-title={project.url.split("/")[3].slice(0, -4)} hidden>

                                <project.Content />

                            </div>

                        })}

                    </div>

                    <div class="supplementary-materials">

                        <div class="pictures-container">
                            <div class="pictures-title">Pictures</div>
                        </div>

                        <div class="files-container">
                            <div class="files-title">Relevant Files</div>
                        </div>

                    </div>

                </div>

                <div class="back-arrow-container" id="back-arrow-container">

                    <Icon name="Dropdown_Arrow" class="back-arrow"/>

                </div>

                <div class="msg-container">

                    <span>Hover on the left side to exit!</span>

                </div>

            </div>

        </div>

    </div>

</BaseLayout>

<script>

    import { cloneWith, debounce } from 'lodash';

    const sectionContainer = document.querySelector(".section-container");

    const detailsSection = document.querySelector(".details-section") as HTMLElement;

    const experienceContentBox = document.querySelector(".experience-content-box") as HTMLElement;

    const cards = document.querySelectorAll(".card");

    const backArrowContainer = document.querySelector(".back-arrow-container") as HTMLElement;

    const msgContainer = document.querySelector(".msg-container") as HTMLElement;

    cards.forEach(addDetailHandlers);

    detailsSection?.addEventListener("mousemove", debounce(checkMousePosition, 10));

    backArrowContainer?.addEventListener("click", closeDetails);

    window.addEventListener("scroll", debounce(moveDetails, 50));

    function checkMousePosition(evt: any) {

        console.log(evt.offsetX);

        if (evt.offsetX <= 0.1 * detailsSection.clientWidth || evt.target.id == "back-arrow-container") { backArrowContainer.style.transform = 'translateX(0)'; }

        else { backArrowContainer.style.transform = 'translateX(-100%)'; }

    }

    function moveDetails() {

        const scrollDistance = window.scrollY;

        detailsSection.style.transform = `translateX(200%) translateY(${scrollDistance}px)`;

    }

    function closeDetails() {

        sectionContainer?.setAttribute("data-details", "false");
        document.body.style.overflow = '';

        document.querySelector("footer")!.style.opacity = "1";

        msgContainer.classList.remove("fade-in");

        experienceContentBox.style.overflow = "hidden";

    }

    function addDetailHandlers(card: any) {

        card.addEventListener("click", async () => {

            const targetFileName = card.getAttribute("data-title");

            const projects = import.meta.glob('../../content/experiences/*.mdx');
            
            const targetProject: any = await projects[`../../content/experiences/${targetFileName}.mdx`]();

            const targetProjectFrontmatter = targetProject.frontmatter;

            console.log(targetProjectFrontmatter)

            document.querySelectorAll(".mdx-body").forEach((elem) => {

                elem.setAttribute("hidden", "");

            });

            document.querySelector(".details-title")!.textContent = targetProjectFrontmatter.title;
            document.querySelector(".details-company")!.textContent = targetProjectFrontmatter.company;

            msgContainer.classList.add("fade-in");

            backArrowContainer.style.transform = 'translateX(-100%)';

            console.log(targetFileName);

            const body = document.querySelector(`.mdx-body[data-title=${targetFileName}]`) as HTMLElement;
            body.removeAttribute("hidden");
            console.log(body.scrollHeight, body.parentElement!.clientHeight);
            body.setAttribute("data-overflow", `${body.scrollHeight > body.parentElement!.clientHeight}`);

            sectionContainer?.setAttribute("data-details", "true");

            document.body.style.overflow = 'hidden';

            document.querySelector("footer")!.style.opacity = "0";

            detailsSection.style.setProperty("--bg-color", `${targetProjectFrontmatter.primaryColor}88`);

            // prevents the details section from being cut off
            experienceContentBox.style.overflow = 'visible';

        });

    }

    moveDetails();

</script>

<style>

    .details-section {

        --bg-color: none;
        --color: white;

        height: calc(100vh - 6em);
        width: 50%;

        position: fixed;
        transform: translateX(200%);

        border-radius: 2em;
        padding: 2em;

        background-color: var(--bg-color);
        overflow: hidden;

        display: flex;
        flex-direction: column;

    }

    .pictures-container, .files-container {

        width: 100%;
        height: 50%;

    }

    .description, .supplementary-materials {

        height: 100%;
        width: 50%;

        color: var(--color);

        overflow: scroll;

    }

    .description-and-materials {

        height: 85%;
        display: flex;

    }

    .description {

        padding-right: 1em;
        position: relative;

    }

    .title-and-company {

        height: 15%;
        width: 100%;
        display: flex;
        flex-direction: column;

        justify-content: center;
        align-items: center;

        color: var(--color);

    }

    .details-title {
        
        font-weight: 900;
        font-size: 1.6em;

    }

    .details-company {

        font-weight: 600;
        font-size: 0.8em;

    }

    .msg-container {

        position: absolute;
        width: 300px;
        height: 100px;
        top: calc(50% - 50px);
        left: calc(50% - 150px);

        display: flex;
        align-items: center;
        justify-content: center;

        pointer-events: none;
        scale: 2;
        filter: none;

        text-shadow: 0px 0px 10px var(--custom-black);

    }

    .fade-in {

        animation: opening-msg-animation 2s forwards;

    }

    .msg-container span {

        font-weight: 900;
        color: var(--custom-white);
        font-size: 1em;

    }

    @keyframes opening-msg-animation {

        0% {

            opacity: 0;
            scale: 0;
            filter: var(--BIG-blur);


        }

        40% {

            opacity: 1;
            scale: 2;
            filter: none;

        }

        80% {

            opacity: 1;
            scale: 2;
            filter: none;

        }

        100% {

            opacity: 0;
            scale: 3;
            filter: var(--BIG-blur);

        }

    }

    .back-arrow-container {

        position: absolute;
        height: 100%;
        width: 20%;
        top: 0;
        left: 0;
        display: flex;
        align-items: center;
        justify-content: center;

        transition: 0.4s var(--standard-transition-timing-no-bounce);
            
    }

    .back-arrow-container:hover {

        cursor: pointer;

    }

    .back-arrow-container::after {

        content: '';
        position: absolute;
        background-color: var(--custom-black-t);
        width: 100%;
        height: 100%;

        backdrop-filter: var(--BIG-blur);
        mask: linear-gradient(to right, rgba(0,0,0,1) 0%, rgba(0,0,0,0));

    }

    .back-arrow {

        transform: rotate(90deg);
        z-index: 1;
        color: var(--custom-white);
        height: 2em;

    }

    .experience-content-box {

        padding: 4em 2em 0em 2em;
        max-width: 100vw;
        box-sizing: border-box;
        overflow: hidden;

    }

    .section-container {

        display: flex;

        width: 200%;
        position: relative;

        transition: 0.6s var(--standard-transition-timing-no-bounce);

    }

    [data-details="true"] {

        transform: translateX(-100%);

    }

    [data-details="false"] {

        transform: translateX(0);

    }

    .projects-section {

        height: auto;
        width: 50%;

    }

    .mdx-body {

        --color: white;

        color: var(--color);

    }

    @media screen and (max-width: 850px) {
        
        h1 {

            text-align: center;

        }

    }

</style>