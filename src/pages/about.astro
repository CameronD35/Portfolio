---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const pageTitle = "About Me";

const identity = {

    name: "Cameron DeMartini",
    country: "United States",
    occupation: "Mathematics & Physics Tutor",
    hobbies: ["Graphic Design", "Programming", "RockSat"]

}

const skills = ["JS/CSS/HTML", "C/C++", "Java", "Calculus", "Differential Equations", "Linear Algebra", "Mechanics", "Electromagnetism", "Project Management"];

const happy = true;
const finished = false;
const goal = 3;

const fontWeight = "bold";

const textCase = "uppercase";

---

<BaseLayout pageTitle={pageTitle}>

    <div class="std-content-box" id="about-me-content-box">
        
        <h1>{pageTitle}</h1>

        <div class="name-section">
            <span class="pre-name">My name is</span>

            <span class="name">
                {identity.name}
            </span>
        </div>

        <div class="skills-box">

            <div class="skill-row" id="row-1">
                {skills.map((skill) => <span class="skill">{skill}</span>)}
            </div>

            <div class="skill-row" id="row-2">
                {skills.map((skill) => <span class="skill">{skill}</span>)}
            </div>

            <div class="skill-row" id="row-3">
                {skills.map((skill) => <span class="skill">{skill}</span>)}
            </div>

        </div>

        {happy && <p>I am not happy AT ALL to be learning Astro :(</p>}
        {finished && <p>I finished this tutorial!</p>}
        {goal === 3 ? <p>My goal is to finish in 3 days.</p> : <p>My goal is to finish in not 3 days.</p>}


    </div>

</BaseLayout>

<style define:vars={{}}>

    .skill {
        font-size: 2em;
        font-weight: 900;
        text-transform: uppercase;
    }

    .skills-box {

        mask: linear-gradient(to right, rgba(0,0,0,0), rgba(0,0,0,1) 20%, rgba(0,0,0,1) 80%, rgba(0,0,0,0) 100%);

    }

    #row-1 .skill {

        animation-name: move-left;
        animation-duration: 3s;

    }

    #row-3 .skill {

        transform: translateX(2em);

    }

    @keyframes move-left {

        0% {

            transform: translateX(0%);

        }

        100% {

            transform: translateX(-50%);

        }

    }

    .skill-row {

        display: flex;
        gap: 2em;
        text-wrap-mode: nowrap;
        justify-content: center;

        overflow: hidden;

    }

    .name-section {

        display: flex;
        flex-direction: column;

    }

    .pre-name{

        font-size: 1.5em;

    }

    .name {
        font-size: 3em;
        font-weight: 900;

    }

</style>