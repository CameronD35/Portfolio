---
import PreviewGallery from '../components/PreviewGallery.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const pageTitle = "About Me";

const identity = {

    name: "Cameron DeMartini",
    country: "United States",
    occupation: "Mathematics & Physics Tutor",
    hobbies: ["Graphic Design", "Programming", "RockSat"]

}

const skills = ["JS/CSS/HTML", "C/C++", "Java", "Calculus", "Differential Equations", "Linear Algebra", "Mechanics", "Electromagnetism", "Project Management", ":]"];

const happy = true;
const finished = false;
const goal = 3;

const fontWeight = "bold";

const textCase = "uppercase";

let skillBg = "";

for (let i = 0; i < 1000; i++) {

    skillBg = skillBg + skills[Math.floor(Math.random() * skills.length)] + "\u2003";

}

---

<BaseLayout pageTitle={pageTitle}>

    <div class="std-content-box" id="about-me-content-box">
        
        <h1>{pageTitle}</h1>

        <div class="name-section">
            <span class="pre-name">My name is</span>

            <span class="name">
                {identity.name}
            </span>
        </div>

        <div class="info">

            <div class="desc">
                This is a very descriptive description of how I describe myself.
            </div>

            <div class="pictures">

                <PreviewGallery images={["img1", "img2", "img3"]} width="300px" height="450px"/>

            </div>

        </div>


    </div>

    <div class="skills-bg">

        {skillBg}

    </div>

</BaseLayout>

<style define:vars={{}}>

    .info {

        display: flex;
        width: 100%;
        flex-grow: 1;

    }

    .desc {

        width: 60%;
        height: 100%;
        padding-right: 5em;

    }

    .pictures {

        width: 40%;
        height: 100%;

    }

    .skills-bg {

        position: fixed;
        top: 0;
        width: 150vw;
        overflow: hidden;
        text-wrap: unset;

        font-weight: 700;
        font-size: 1.5em;

        color: var(--custom-black-t);

        opacity: 0.1;

        z-index: -5;

    }

    .skill {
        font-size: 2em;
        font-weight: 900;
        text-transform: uppercase;
    }

    .skills-box {

        mask: linear-gradient(to right, rgba(0,0,0,0), rgba(0,0,0,1) 20%, rgba(0,0,0,1) 80%, rgba(0,0,0,0) 100%);
        position: relative;

        width: fit-content;
        display: flex;
        gap: 2em;
        text-wrap-mode: nowrap;

    }

    .name-section {

        display: flex;
        flex-direction: column;

    }

    .pre-name{

        font-size: 1.5em;

    }

    .name {
        font-size: 3em;
        font-weight: 900;

    }

</style>