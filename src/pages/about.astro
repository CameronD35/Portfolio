---
import PreviewGallery from '../components/PreviewGallery.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';

const pageTitle = "About Me";

const identity = {

    name: "Cameron DeMartini",
    country: "United States",
    occupation: "Mathematics & Physics Tutor",
    hobbies: ["Graphic Design", "Programming", "RockSat"]

}

const skills = ["JS/CSS/HTML", "C/C++", "Java", "Python", "Calculus", "Differential Equations", "Linear Algebra", "Mechanics", 
"Electromagnetism", "Project Management", "LaTeX", "Adobe Photoshop", "Adobe Illustrator", "Web Design & Development", ">:]",
"Graphic Design"];

let skillBg = "";

for (let i = 0; i < 1000; i++) {

    skillBg = skillBg + skills[Math.floor(Math.random() * skills.length)] + "\u2003";

}

---

<BaseLayout pageTitle={pageTitle}>

    <div class="std-content-box" id="about-me-content-box">
        
        <h1>{pageTitle}</h1>

        <div class="name-section">
            <span class="pre-name">My name is</span>

            <span class="name">
                {identity.name}
            </span>
        </div>

        <div class="info">

            <div class="desc">
                (I'll do the formatting later)

                Hello!! I'm an Aerospace Engineering/Applied Physics major (depending where I get into) currently attending Collge of the Canyons in Santa Clarita, CA. 
                Before I get too excited talking about what I do, I'd like to introduce my story (at least my more "professional" one for now).

                You may be wondering "What is an Aerospace Engineering dude doing with web design and development?" That's a perfectly valid question and one I get all the time.
                
                It all really began with my time at the Astornomy & Physics Club (a club where we get to send stuff into space!!). I happened to be learning some JavaScript towards
                the end of the RockSatX 2023 project when the project manager at the time proposed an idea: a data dashboard.
                <br><br>
                To be continued...
                <br><br>

                But let's not be all boring and professional here, so here are some other things about me:

                <ul>

                    <li>
                        My favorite musical artist is Justin Bieber. (If you've ever met me and hung out, you'd know that Justin Bieber
                        is pretty much all you will hear when I'm driving)
                    </li>
                    <li>
                        My favorite color is purple. Now, purple is too broad, so I'm going to have to say a nice mildly vivid purple is perfect (insert box with color here).
                    </li>
                    <li>
                        My favorite hobby (besides coding, math, physics, etc.) has to go to graphic design. Since my dad introduced me to Photoshop back in 2015, I saw the
                        shape tool and it was off to the races. It's always a funny thing to say that I primarily do graphic design work in Photoshop because that seems to
                        be quite untraditional. Most people anticipate Illustrator, but I've only just recently (meaning the last year or so) began using Illustrator.
                    </li>
                    
                </ul>
            </div>

            <div class="pictures">

                <PreviewGallery imageNames={["MDOSC.webp", "MDOSC.webp", "MDOSC.webp"]} width="600px" height="800px"/>

            </div>

        </div>


    </div>

    <div class="skills-bg">

        {skillBg}

    </div>

</BaseLayout>

<style define:vars={{}}>

    .info {

        display: flex;
        width: 100%;
        flex-grow: 1;

    }

    .desc {

        width: 60%;
        height: 100%;
        padding-right: 5em;

    }

    .pictures {

        width: 40%;
        height: 100%;

    }

    .skills-bg {

        position: fixed;
        top: 0;
        width: 150vw;
        overflow: hidden;
        text-wrap: unset;

        font-weight: 700;
        font-size: 1.5em;

        color: var(--custom-black-t);

        opacity: 0.1;

        z-index: -5;

    }

    .skill {
        font-size: 2em;
        font-weight: 900;
        text-transform: uppercase;
    }

    .skills-box {

        mask: linear-gradient(to right, rgba(0,0,0,0), rgba(0,0,0,1) 20%, rgba(0,0,0,1) 80%, rgba(0,0,0,0) 100%);
        position: relative;

        width: fit-content;
        display: flex;
        gap: 2em;
        text-wrap-mode: nowrap;

    }

    .name-section {

        display: flex;
        flex-direction: column;

    }

    .pre-name{

        font-size: 1.5em;

    }

    .name {
        font-size: 3em;
        font-weight: 900;

    }

</style>