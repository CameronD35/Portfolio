---
import BaseLayout from "../layouts/BaseLayout.astro";
import FullWidthSection from "../components/FullWidthSection.astro";
import bgImage from "../images/bg.webp";
import Signature from "../components/Signature.astro";
import "../styles/global.css"
import MajorSection from "../components/MajorSection.astro";
import Button from "../components/Button.astro";

const pageTitle = "Home Page"
---

<BaseLayout pageTitle={pageTitle}>
	
	<FullWidthSection height="100vh" bgImg={bgImage} className="center-items">

		<Signature width="80vw" color="var(--custom-white-st)" outline={true}/>

		<Button href="/about" styleFlags={["fixed", "big"]}>Learn more about me!</Button>

	</FullWidthSection>

	<MajorSection title="Tutoring" desc="After experience tutoring students across first and second year mathematics, physics, and even a bit of chemistry, I am now available for private tutoring in San Luis Obispo, CA!" isLeft="false" color="var(--custom-dark-purple)" buttonmsg="Discover my journey!" href="/tutoring" imageNames={["221worksheet.webp", "m214ws.webp", "p221ws.webp"]}/>
	<MajorSection title="Software Engineering" desc="As I always say, my heart will always be with software engineering. With years of data dashboarding experience and many C/C++ programs under my belt, programming is not an afterthought!" isLeft="true" color="var(--custom-purple)" buttonmsg="See some of my projects!" href="/experience/software-engineering" imageDirectory="photography"/>
	<MajorSection title="Graphic Design" desc="Every since my father introduced me to Adobe Photoshop way back in 2015, I've made sure nearly all of my projects incorporated some level of graphic design." isLeft="false" color="var(--custom-light-blue)" buttonmsg="Check out my designs!" href="/experience/graphic-design" imageDirectory="themes" imageNames={["justin-bieber/SWAG_TOP5_FILLED.webp", "marztg/RegLogo.webp", "justin-bieber/JB-UnreleasedCover.webp"]}/>
	<MajorSection title="Photography" desc="Taking photos has always allowed me to notice beauties that I otherwise would've missed. No matter how crazy life gets, I always find myself returning to photography when I can!" isLeft="true" color="var(--custom-dark-blue)" buttonmsg="Check out my photos!" href="/experience/photography" imageDirectory="photography"/>

</BaseLayout>

<style is:global>

	@keyframes animate-sig {

		100% {

			stroke-dashoffset: 0px;

		} 

	}

	.section::before {
    	content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	
</style>
